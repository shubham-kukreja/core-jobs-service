# Copy to deploy/stack/stack.env (gitignored) and replace every value.
# Generate secrets with: openssl rand -base64 36
OWNER_DB_PASSWORD=change-me
APP_DB_PASSWORD=change-me
BLOB_ACCESS_KEY=change-me
BLOB_SECRET_KEY=change-me
GRAFANA_ADMIN_PASSWORD=change-me
# At least 32 bytes. Signs CSRF tokens and cursors; rotating it logs everyone out.
SECRET_KEY=change-me-to-at-least-32-random-bytes
# The first admin account (make stack-init); its password is read from ADMIN_PASSWORD once.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-long-passphrase
LOG_LEVEL=info
APP_TIMEZONE=Asia/Kolkata
