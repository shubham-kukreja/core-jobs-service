# Copy to .env for local overrides. Never commit real values; staging and
# production read these from the secret manager. Variables also accept a
# *_FILE form (e.g. SECRET_KEY_FILE=/run/secrets/secret_key).

APP_ENV=development
APP_TIMEZONE=Asia/Kolkata
LOG_LEVEL=info

# Runtime user (member of app_runtime: DML only).
DATABASE_URL=postgres://core_app:dev_app_password@127.0.0.1:5432/core?sslmode=disable
# Owner user, used only by `app migrate`.
MIGRATION_DATABASE_URL=postgres://core_owner:dev_owner_password@127.0.0.1:5432/core?sslmode=disable
DB_MAX_CONNS=20

HTTP_ADDR=127.0.0.1:8088
METRICS_ADDR=127.0.0.1:9090
MAX_REQUEST_BYTES=1048576
MAX_UPLOAD_BYTES=20971520
# Exact origins only; no wildcards. https required outside development.
CORS_ORIGINS=http://localhost:5173
# CIDRs of the load balancer, so client IPs are read from X-Forwarded-For only behind it.
TRUSTED_PROXY_CIDRS=

SESSION_IDLE_TTL=30m
SESSION_ABSOLUTE_TTL=12h
COOKIE_DOMAIN=

# 32+ random bytes, e.g. `openssl rand -base64 48`.
SECRET_KEY=

BLOB_ENDPOINT=127.0.0.1:9000
BLOB_BUCKET=core-dev
BLOB_ACCESS_KEY=dev_s3_access
BLOB_SECRET_KEY=dev_s3_secret_key
BLOB_USE_TLS=false
